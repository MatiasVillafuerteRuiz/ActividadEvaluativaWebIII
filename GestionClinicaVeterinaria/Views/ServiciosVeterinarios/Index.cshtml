@model IEnumerable<GestionClinicaVeterinaria.Models.ServicioVeterinario>

@{
    ViewData["Title"] = "Servicios Veterinarios";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Servicios Veterinarios</h1>
            <p class="text-muted mb-0">
                Administración de los servicios ofrecidos por la clínica.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Nuevo servicio
        </a>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Servicio</th>
                                <th>Descripción</th>
                                <th>Precio</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var servicio in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @servicio.NombreServicio
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(servicio.Descripcion))
                                        {
                                            <span class="text-muted">
                                                Sin descripción
                                            </span>
                                        }
                                        else
                                        {
                                            @servicio.Descripcion
                                        }
                                    </td>

                                    <td>
                                        Bs @servicio.Precio.ToString("N2")
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@servicio.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Detalles
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@servicio.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@servicio.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>No existen servicios registrados</h5>

                    <p class="text-muted">
                        Registra el primer servicio veterinario.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Crear servicio
                    </a>

                </div>
            }

        </div>

    </div>

</div>