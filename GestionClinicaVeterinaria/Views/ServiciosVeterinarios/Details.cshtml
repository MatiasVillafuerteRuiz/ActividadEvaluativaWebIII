@model GestionClinicaVeterinaria.Models.ServicioVeterinario

@{
    ViewData["Title"] = "Detalles del Servicio";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="mb-4">

                <h1 class="fw-bold">
                    Detalles del servicio
                </h1>

                <p class="text-muted">
                    Información registrada del servicio veterinario.
                </p>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="mb-4">

                        <small class="text-muted">
                            Nombre
                        </small>

                        <h4 class="fw-bold">
                            @Model.NombreServicio
                        </h4>

                    </div>


                    <div class="mb-4">

                        <small class="text-muted">
                            Descripción
                        </small>

                        <p class="mb-0">

                            @if (string.IsNullOrWhiteSpace(Model.Descripcion))
                            {
                                <span class="text-muted">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @Model.Descripcion
                            }

                        </p>

                    </div>


                    <div class="mb-4">

                        <small class="text-muted">
                            Precio
                        </small>

                        <h5>
                            Bs @Model.Precio.ToString("N2")
                        </h5>

                    </div>


                    <div class="d-flex gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Editar
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Volver
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>