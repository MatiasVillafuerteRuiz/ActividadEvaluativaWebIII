@model IEnumerable<GestionClinicaVeterinaria.Models.Cita>

@{
    ViewData["Title"] = "Administración de Citas";
}

<div class="container py-4">

    <!-- ============================================= -->
    <!-- ENCABEZADO -->
    <!-- ============================================= -->

    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Administración de citas
        </h1>

        <p class="text-muted mb-0">
            Consulta todas las citas registradas en la clínica veterinaria.
        </p>

    </div>


    <!-- ============================================= -->
    <!-- MENSAJES -->
    <!-- ============================================= -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Exito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- ============================================= -->
    <!-- TABLA -->
    <!-- ============================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Mascota</th>
                                <th>Cliente</th>
                                <th>Servicio</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th class="text-end">
                                    Acciones
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var cita in Model)
                            {
                                <tr>

                                    <!-- MASCOTA -->

                                    <td>

                                        <span class="fw-semibold">
                                            @cita.Mascota?.Nombre
                                        </span>

                                        <br />

                                        <small class="text-muted">
                                            @cita.Mascota?.Especie
                                        </small>

                                    </td>


                                    <!-- CLIENTE -->

                                    <td>

                                        @if (cita.Mascota?.Usuario != null)
                                        {
                                            <span>
                                                @cita.Mascota.Usuario.Nombre
                                                @cita.Mascota.Usuario.Apellido
                                            </span>

                                            <br />

                                            <small class="text-muted">
                                                @cita.Mascota.Usuario.Email
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin información
                                            </span>
                                        }

                                    </td>


                                    <!-- SERVICIO -->

                                    <td>
                                        @cita.ServicioVeterinario?.NombreServicio
                                    </td>


                                    <!-- FECHA -->

                                    <td>

                                        @cita.FechaHora.ToString(
                                            "dd/MM/yyyy HH:mm")

                                    </td>


                                    <!-- ESTADO -->

                                    <td class="text-end">

                                        <div class="d-flex gap-2 justify-content-end align-items-center">

                                            <!-- ======================================= -->
                                            <!-- CAMBIAR ESTADO -->
                                            <!-- ======================================= -->

                                            <form asp-action="CambiarEstado"
                                                  method="post"
                                                  class="d-flex gap-2">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@cita.Id" />

                                                <select name="estado"
                                                        class="form-select form-select-sm"
                                                        style="width: 130px;">

                                                    @if (cita.Estado == "Pendiente")
                                                    {
                                                        <option value="Pendiente" selected>
                                                            Pendiente
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Pendiente">
                                                            Pendiente
                                                        </option>
                                                    }


                                                    @if (cita.Estado == "Atendida")
                                                    {
                                                        <option value="Atendida" selected>
                                                            Atendida
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Atendida">
                                                            Atendida
                                                        </option>
                                                    }


                                                    @if (cita.Estado == "Cancelada")
                                                    {
                                                        <option value="Cancelada" selected>
                                                            Cancelada
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Cancelada">
                                                            Cancelada
                                                        </option>
                                                    }

                                                </select>


                                                <button type="submit"
                                                        class="btn btn-sm btn-primary">

                                                    Cambiar

                                                </button>

                                            </form>


                                            <!-- ======================================= -->
                                            <!-- DETALLES -->
                                            <!-- ======================================= -->

                                            <a asp-action="Details"
                                               asp-route-id="@cita.Id"
                                               class="btn btn-sm btn-outline-secondary">

                                                Detalles

                                            </a>

                                        </div>

                                    </td>


                                    <!-- ACCIONES -->

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@cita.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            Detalles

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>
                        No existen citas registradas
                    </h5>

                    <p class="text-muted mb-0">
                        Las citas solicitadas por los clientes aparecerán aquí.
                    </p>

                </div>
            }

        </div>

    </div>

</div>